# Copy to .env; docker compose, the Taskfile and the app all read it.
# Dev values only. In production every password comes from a secret store and
# both URLs use sslmode=verify-full.

# Postgres superuser (Docker + `task db:psql` only; the app never uses it)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=templ_app
POSTGRES_PORT=5432

# Application roles (created by db/init/01-roles.sh on first `task db`)
APP_DB_PASSWORD=app-dev-password
MIGRATOR_DB_PASSWORD=migrator-dev-password

# Runtime connection: least-privilege role, DML on granted tables only
DATABASE_URL=postgres://templ_app:app-dev-password@localhost:5432/templ_app?sslmode=disable

# Migrations (task db:migrate / go run ./cmd/migrate): owns the schema
MIGRATE_DATABASE_URL=postgres://templ_app_migrator:migrator-dev-password@localhost:5432/templ_app?sslmode=disable

# Application ---------------------------------------------------------------
# GO_ENV=production turns on the safety rails (encryption key required, dev
# flags refused, long asset cache headers).
GO_ENV=development

# AES-256 key(s) for values that must be recoverable: webhook signing secrets,
# TOTP seeds. Format v<n>:<64 hex chars>, comma-separated to rotate (highest
# version encrypts, all listed versions decrypt). Generate one with:
#   printf 'v1:%s\n' "$(openssl rand -hex 32)"
# Optional in development (MFA enrolment and webhook endpoints are then
# disabled), required in production.
APP_ENCRYPTION_KEY=

# Development only. Derives fake, format-valid deposit addresses for every
# seeded provider and runs an in-memory chain the worker scans and broadcasts
# to, so deposits, confirmations and payouts can be exercised without nodes.
DEV_CHAIN_ADAPTER=true
# How fast the fake chain produces blocks. A network confirms after its
# required_confirmations blocks, so 1s means Tron deposits take about 19s.
DEV_CHAIN_BLOCK_TIME=1s
# Development only. Lets webhook endpoints point at localhost / private IPs.
WEBHOOK_ALLOW_PRIVATE=true
# Refuse withdrawals to addresses that are not saved and whitelisted.
REQUIRE_WITHDRAWAL_WHITELIST=false
# Trust X-Forwarded-For for client IPs (set behind Render's proxy).
# TRUST_PROXY=1

# Tunables (Go durations). Defaults shown.
# SESSION_TTL=720h
# RATE_LOCK=15m
# INVOICE_TTL=1h
# MAX_RATE_AGE=10m
# WEBHOOK_TIMEOUT=10s
# TOTP_ISSUER=Payments

# Development seed: creates a demo user, merchant, wallets on every enabled
# network and placeholder exchange rates at startup, then logs the login.
# Needs DEV_CHAIN_ADAPTER=true. Never enabled in production.
DEV_SEED=true
DEV_SEED_EMAIL=demo@example.com
DEV_SEED_PASSWORD=demo-password-123
# How fast the fake chain's head advances (a network confirms after its
# required_confirmations blocks).
DEV_CHAIN_BLOCK_TIME=1s
