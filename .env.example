# Copy to .env; docker compose, the Taskfile and the app all read it.
# Dev values only. In production every password comes from a secret store and
# both URLs use sslmode=verify-full.

# Postgres superuser (Docker + `task db:psql` only; the app never uses it)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=templ_app
POSTGRES_PORT=5432

# Application roles (created by db/init/01-roles.sh on first `task db`)
APP_DB_PASSWORD=app-dev-password
MIGRATOR_DB_PASSWORD=migrator-dev-password

# Runtime connection: least-privilege role, DML on granted tables only
DATABASE_URL=postgres://templ_app:app-dev-password@localhost:5432/templ_app?sslmode=disable

# Migrations (task db:migrate / go run ./cmd/migrate): owns the schema
MIGRATE_DATABASE_URL=postgres://templ_app_migrator:migrator-dev-password@localhost:5432/templ_app?sslmode=disable
