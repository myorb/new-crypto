package layouts

import (
	"net/url"
	"templ-app/components/avatar"
	"templ-app/components/badge"
	"templ-app/components/dropdownmenu"
	"templ-app/components/icon"
	"templ-app/components/separator"
	"templ-app/components/sidebar"
	"templ-app/components/themetoggle"
	"templ-app/utils"
)

// DashboardProps configures the dashboard shell for one page.
type DashboardProps struct {
	// Title is the page heading in the header and the browser tab title.
	Title string
	// Subtitle is optional muted text on the right side of the header.
	Subtitle string
	// ActivePath highlights the nav item whose Href matches.
	ActivePath string
	// Merchant, Initials and Plan describe the current organization shown
	// in the header switcher.
	Merchant string
	Initials string
	Plan     string
	// Orgs lists every organization the user belongs to, for the switcher.
	Orgs []Org
	// User is the signed-in person shown in the footer account menu.
	User User
	// Sandbox shows the amber test-mode banner and switch state. Toggle it
	// through GET /mode?set=sandbox|live&next=<path> (see main.go).
	Sandbox bool
}

// Org is one organization in the header switcher.
type Org struct {
	Name     string
	Plan     string
	Initials string
	Href     string
	Current  bool
}

// User is the signed-in person.
type User struct {
	Name     string
	Email    string
	Initials string
	Role     string // role inside the current organization
}

// modeHref is the link that switches to sandbox or live and returns to
// the current page.
func modeHref(p DashboardProps, sandbox bool) templ.SafeURL {
	mode := "live"
	if sandbox {
		mode = "sandbox"
	}
	next := p.ActivePath
	if next == "" {
		next = "/dashboard"
	}
	return templ.SafeURL("/mode?set=" + mode + "&next=" + url.QueryEscape(next))
}

// Dashboard is the app shell: collapsible inset sidebar, slim header and a
// centered content column. Every dashboard page wraps its content in it.
templ Dashboard(p DashboardProps) {
	@Base(p.Title + " · PayChain") {
		@sidebar.Provider() {
			@dashboardSidebar(p)
			@sidebar.Inset() {
				@dashboardHeader(p)
				if p.Sandbox {
					@sandboxBanner(p)
				}
				<main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 pt-6 pb-28 sm:px-6 md:pb-6">
					{ children... }
				</main>
				@dashboardBottomBar(p)
			}
		}
	}
}

type navItem struct {
	Label string
	Href  string
	Icon  func(...icon.Props) templ.Component
}

var merchantNav = []navItem{
	{Label: "Overview", Href: "/dashboard", Icon: icon.LayoutDashboard},
	{Label: "Payments", Href: "/dashboard/payments", Icon: icon.ArrowLeftRight},
	{Label: "Payment links", Href: "/dashboard/links", Icon: icon.Link},
	{Label: "Payouts", Href: "/dashboard/payouts", Icon: icon.Landmark},
	{Label: "Wallets", Href: "/dashboard/wallets", Icon: icon.Wallet},
	{Label: "Customers", Href: "/dashboard/customers", Icon: icon.Users},
}

var developerNav = []navItem{
	{Label: "API keys", Href: "/dashboard/api-keys", Icon: icon.KeyRound},
	{Label: "Webhooks", Href: "/dashboard/webhooks", Icon: icon.Webhook},
}

var organizationNav = []navItem{
	{Label: "Settings", Href: "/dashboard/settings", Icon: icon.Settings},
	{Label: "Billing", Href: "/dashboard/settings?tab=billing", Icon: icon.CreditCard},
}

templ dashboardSidebar(p DashboardProps) {
	@sidebar.Sidebar(sidebar.Props{Variant: sidebar.VariantInset, Collapsible: sidebar.CollapsibleIcon, MobileSide: sidebar.SideBottom}) {
		@sidebar.Header() {
			@sidebar.Menu() {
				@sidebar.MenuItem() {
					@orgSwitcher(p)
				}
			}
		}
		@sidebar.Content() {
			@sidebar.Group() {
				@sidebar.GroupContent() {
					@sidebar.Menu() {
						for _, item := range merchantNav {
							@navMenuItem(item, item.Href == p.ActivePath)
						}
					}
				}
			}
			@sidebar.Group() {
				@sidebar.GroupLabel() {
					Developers
				}
				@sidebar.GroupContent() {
					@sidebar.Menu() {
						for _, item := range developerNav {
							@navMenuItem(item, item.Href == p.ActivePath)
						}
					}
				}
			}
			@sidebar.Group(sidebar.GroupProps{Class: "mt-auto"}) {
				@sidebar.GroupLabel() {
					Organization
				}
				@sidebar.GroupContent() {
					@sidebar.Menu() {
						for _, item := range organizationNav {
							@navMenuItem(item, item.Href == p.ActivePath)
						}
					}
				}
			}
		}
		@sidebar.Footer() {
			@sidebar.Menu() {
				@sidebar.MenuItem() {
					@userMenu(p)
				}
			}
		}
		@sidebar.Rail()
	}
}

// orgSwitcher is the header button: the current organization with a menu
// to jump between organizations or into organization-level settings.
templ orgSwitcher(p DashboardProps) {
	@dropdownmenu.DropdownMenu() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{Size: sidebar.MenuButtonSizeLg, Attributes: dropdownmenu.Trigger(ctx)}) {
			<div class="bg-primary text-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg text-xs font-bold">
				{ p.Initials }
			</div>
			<div class="grid flex-1 text-left text-sm leading-tight">
				<span class="truncate font-semibold">{ p.Merchant }</span>
				<span class="text-muted-foreground truncate text-xs">{ p.Plan }</span>
			</div>
			@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-4"})
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignStart, Side: dropdownmenu.SideBottom, MobileSide: dropdownmenu.SideTop, Class: "w-64"}) {
			@dropdownmenu.Label(dropdownmenu.LabelProps{Class: "text-muted-foreground text-xs"}) {
				Organizations
			}
			for _, o := range p.Orgs {
				@dropdownmenu.Item(dropdownmenu.ItemProps{Href: o.Href, Class: "gap-2 p-2"}) {
					<div class={ utils.CN("flex size-6 items-center justify-center rounded-md text-[10px] font-bold", utils.IfElse(o.Current, "bg-primary text-primary-foreground", "bg-muted text-muted-foreground")) }>
						{ o.Initials }
					</div>
					<div class="grid flex-1 leading-tight">
						<span class="truncate">{ o.Name }</span>
						<span class="text-muted-foreground truncate text-xs">{ o.Plan }</span>
					</div>
					if o.Current {
						@icon.Check(icon.Props{Class: "text-primary size-4"})
					}
				}
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: "/dashboard/settings"}) {
				@icon.Settings()
				Organization settings
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: "/dashboard/settings?tab=team"}) {
				@icon.UserPlus()
				Invite members
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: "/dashboard/settings?tab=billing"}) {
				@icon.CreditCard()
				Billing & plan
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: "#"}) {
				@icon.Plus()
				Create organization
			}
		}
	}
}

// userMenu is the footer button: the signed-in person with links to their
// personal account settings, the sandbox switch and sign out.
templ userMenu(p DashboardProps) {
	@dropdownmenu.DropdownMenu() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{Size: sidebar.MenuButtonSizeLg, Attributes: dropdownmenu.Trigger(ctx)}) {
			@avatar.Avatar(avatar.Props{Class: "rounded-lg after:rounded-lg"}) {
				@avatar.Fallback(avatar.FallbackProps{Class: "rounded-lg"}) {
					{ p.User.Initials }
				}
			}
			<div class="grid flex-1 text-left text-sm leading-tight">
				<span class="truncate font-medium">{ p.User.Name }</span>
				<span class="text-muted-foreground truncate text-xs">{ p.User.Email }</span>
			</div>
			@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-4"})
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Side: dropdownmenu.SideTop, Class: "w-64"}) {
			@dropdownmenu.Label(dropdownmenu.LabelProps{Class: "flex items-center gap-2 p-2 font-normal"}) {
				@avatar.Avatar(avatar.Props{Class: "rounded-lg after:rounded-lg"}) {
					@avatar.Fallback(avatar.FallbackProps{Class: "rounded-lg"}) {
						{ p.User.Initials }
					}
				}
				<div class="grid flex-1 text-left text-sm leading-tight">
					<span class="truncate font-medium">{ p.User.Name }</span>
					<span class="text-muted-foreground truncate text-xs">{ p.User.Email }</span>
				</div>
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px]"}) {
					{ p.User.Role }
				}
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: "/dashboard/account"}) {
				@icon.CircleUser()
				Account settings
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: "/dashboard/account?tab=security"}) {
				@icon.Shield()
				Security
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: "/dashboard/account?tab=notifications"}) {
				@icon.Bell()
				Notifications
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: string(modeHref(p, !p.Sandbox))}) {
				@icon.FlaskConical()
				if p.Sandbox {
					Exit sandbox
				} else {
					Switch to sandbox
				}
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: "#"}) {
				@icon.LifeBuoy()
				Help & support
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: "/logout", Variant: dropdownmenu.ItemVariantDestructive}) {
				@icon.LogOut()
				Sign out
			}
		}
	}
}

templ navMenuItem(item navItem, active bool) {
	@sidebar.MenuItem() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{Href: item.Href, IsActive: active, Tooltip: item.Label}) {
			@item.Icon()
			<span>{ item.Label }</span>
		}
	}
}

templ dashboardHeader(p DashboardProps) {
	<header class="hidden h-14 shrink-0 items-center gap-2 border-b px-4 md:flex">
		@sidebar.Trigger(sidebar.TriggerProps{Class: "-ml-1"})
		@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "mr-2 h-4! self-center"})
		<h1 class="text-sm font-semibold">{ p.Title }</h1>
		if p.Sandbox {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "border-amber-500/40 bg-amber-500/10 text-amber-700 dark:text-amber-400"}) {
				@icon.FlaskConical()
				Sandbox
			}
		}
		<div class="ml-auto flex items-center gap-3">
			if p.Subtitle != "" {
				<span class="text-muted-foreground text-xs">{ p.Subtitle }</span>
			}
			@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "h-4! self-center"})
			@modeSwitch(p)
			@themetoggle.ModeToggle()
		</div>
	</header>
}

// modeSwitch is the live/sandbox toggle. It is a link so it works without
// JavaScript; the server sets the cookie and redirects back.
templ modeSwitch(p DashboardProps) {
	<a
		href={ modeHref(p, !p.Sandbox) }
		role="switch"
		aria-checked={ utils.IfElse(p.Sandbox, "true", "false") }
		aria-label="Sandbox mode"
		title={ utils.IfElse(p.Sandbox, "Switch to live data", "Switch to sandbox data") }
		class="group/switch flex items-center gap-2 text-xs font-medium"
	>
		<span class={ utils.CN("transition-colors", utils.IfElse(p.Sandbox, "text-amber-600 dark:text-amber-400", "text-muted-foreground group-hover/switch:text-foreground")) }>Sandbox</span>
		<span class={ utils.CN("relative inline-flex h-5 w-9 shrink-0 items-center rounded-full border border-transparent transition-colors", utils.IfElse(p.Sandbox, "bg-amber-500", "bg-input dark:bg-input/80 group-hover/switch:bg-input/70")) }>
			<span class={ utils.CN("size-4 rounded-full bg-white shadow-sm transition-transform dark:bg-foreground", utils.IfElse(p.Sandbox, "translate-x-4", "translate-x-0.5")) }></span>
		</span>
	</a>
}

// sandboxBanner sits under the header on every breakpoint while the
// merchant is viewing simulated data.
templ sandboxBanner(p DashboardProps) {
	<div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-amber-500/30 bg-amber-500/10 px-4 py-2 text-sm text-amber-950 sm:px-6 dark:text-amber-100" role="status">
		<span class="flex items-center gap-2 font-medium">
			@icon.FlaskConical(icon.Props{Class: "size-4 text-amber-600 dark:text-amber-400"})
			Sandbox mode
		</span>
		<span class="text-amber-900/80 dark:text-amber-100/70">You're viewing simulated data. Payments are test events and no funds move.</span>
		<span class="ml-auto flex items-center gap-1">
			<a href="/dashboard/api-keys" class="hover:bg-amber-500/15 flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium transition-colors">
				@icon.KeyRound(icon.Props{Class: "size-3.5"})
				API keys
			</a>
			<a href="#" class="hover:bg-amber-500/15 flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium transition-colors">
				@icon.BookOpen(icon.Props{Class: "size-3.5"})
				Docs
			</a>
			<a href={ modeHref(p, false) } class="bg-amber-500 text-amber-950 hover:bg-amber-400 flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold transition-colors">
				Exit sandbox
			</a>
		</span>
	</div>
}

// bottomNav is the mobile quick nav; the drawer trigger and search sit beside it.
var bottomNav = []navItem{
	{Label: "Overview", Href: "/dashboard", Icon: icon.LayoutDashboard},
	{Label: "Payments", Href: "/dashboard/payments", Icon: icon.ArrowLeftRight},
	{Label: "Wallets", Href: "/dashboard/wallets", Icon: icon.Wallet},
}

// dashboardBottomBar replaces the header below md: a floating pill with the
// quick nav and the drawer trigger, plus a round search button.
templ dashboardBottomBar(p DashboardProps) {
	<nav class="fixed inset-x-4 bottom-4 z-40 flex items-center gap-3 pb-[env(safe-area-inset-bottom)] md:hidden" aria-label="Mobile navigation">
		<div class="bg-secondary/90 supports-backdrop-filter:backdrop-blur-md flex flex-1 items-center justify-around rounded-full border p-1.5 shadow-lg">
			for _, item := range bottomNav {
				<a
					href={ templ.SafeURL(item.Href) }
					aria-label={ item.Label }
					aria-current?={ item.Href == p.ActivePath }
					class={ utils.CN(
						"flex size-12 items-center justify-center rounded-full transition-colors [&_svg]:size-5",
						utils.IfElse(item.Href == p.ActivePath, "bg-background text-foreground shadow-sm", "text-muted-foreground hover:text-foreground"),
					) }
				>
					@item.Icon()
				</a>
			}
			@sidebar.Trigger(sidebar.TriggerProps{Class: "size-12 rounded-full text-muted-foreground hover:text-foreground [&_svg]:size-5"})
		</div>
		<a href="#" aria-label="Search" class="bg-secondary/90 supports-backdrop-filter:backdrop-blur-md text-foreground flex size-15 shrink-0 items-center justify-center rounded-full border shadow-lg [&_svg]:size-5">
			@icon.Search()
		</a>
	</nav>
}
