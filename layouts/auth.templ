package layouts

import (
	"templ-app/components/icon"
	"templ-app/components/themetoggle"
)

// Auth is the split shell for sign-in, sign-up and verification screens:
// a brand panel on the left (hidden below lg) and a centred form column.
templ Auth(title string) {
	@Base(title + " · PayChain") {
		<div class="grid min-h-svh lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
			@authBrandPanel()
			<div class="relative flex flex-col">
				<div class="flex items-center justify-between p-4 sm:p-6">
					<a href="/" class="flex items-center gap-2 lg:invisible">
						<span class="bg-primary text-primary-foreground flex size-7 items-center justify-center rounded-lg">
							@icon.Bitcoin(icon.Props{Class: "size-4"})
						</span>
						<span class="text-sm font-semibold">PayChain</span>
					</a>
					@themetoggle.ModeToggle()
				</div>
				<main class="flex flex-1 items-center justify-center px-4 pb-12 sm:px-6">
					<div class="w-full max-w-sm has-[[data-wide]]:max-w-md">
						{ children... }
					</div>
				</main>
				<footer class="text-muted-foreground flex flex-wrap items-center justify-center gap-x-4 gap-y-1 px-6 pb-6 text-xs">
					<a href="#" class="hover:text-foreground">Terms</a>
					<a href="#" class="hover:text-foreground">Privacy</a>
					<a href="#" class="hover:text-foreground">Status</a>
					<span>© 2026 PayChain</span>
				</footer>
			</div>
		</div>
	}
}

templ authBrandPanel() {
	<aside class="bg-sidebar text-sidebar-foreground relative hidden flex-col justify-between overflow-hidden border-r p-10 lg:flex">
		<div class="pointer-events-none absolute inset-0" aria-hidden="true">
			<div class="bg-primary/20 absolute -top-32 -left-32 size-96 rounded-full blur-3xl"></div>
			<div class="bg-chart-2/15 absolute right-0 bottom-0 size-[28rem] translate-x-1/3 translate-y-1/3 rounded-full blur-3xl"></div>
		</div>
		<a href="/" class="relative flex items-center gap-2">
			<span class="bg-primary text-primary-foreground flex size-8 items-center justify-center rounded-lg">
				@icon.Bitcoin(icon.Props{Class: "size-4"})
			</span>
			<span class="font-semibold">PayChain</span>
		</a>
		<div class="relative flex flex-col gap-8">
			<div class="flex flex-col gap-3">
				<h1 class="text-3xl font-semibold tracking-tight text-balance">Accept crypto. Settle in dollars. Sleep at night.</h1>
				<p class="text-muted-foreground max-w-md text-sm">One dashboard for payments, payouts, wallets and the developer tools behind them, across five networks.</p>
			</div>
			<div class="bg-card/60 ring-foreground/5 grid grid-cols-3 gap-4 rounded-2xl p-5 shadow-sm ring-1 backdrop-blur">
				@brandStat("$4.2B", "processed")
				@brandStat("99.98%", "uptime · 12 mo")
				@brandStat("2,400+", "merchants")
			</div>
			<figure class="flex flex-col gap-3">
				<blockquote class="text-sm leading-relaxed">“We switched settlement to PayChain in a week. Refunds, payouts and the audit log just work, and finance finally stopped asking me for CSVs.”</blockquote>
				<figcaption class="flex items-center gap-3 text-xs">
					<span class="bg-muted flex size-8 items-center justify-center rounded-full font-semibold">PR</span>
					<span class="flex flex-col">
						<span class="font-medium">Priya Raman</span>
						<span class="text-muted-foreground">Head of Payments, Northwind Labs</span>
					</span>
				</figcaption>
			</figure>
		</div>
		<div class="text-muted-foreground relative flex items-center gap-2 text-xs">
			@icon.ShieldCheck(icon.Props{Class: "size-3.5 text-emerald-500"})
			SOC 2 Type II · PCI DSS · MPC custody
		</div>
	</aside>
}

templ brandStat(value, label string) {
	<div class="flex flex-col gap-0.5">
		<span class="text-xl font-semibold tracking-tight tabular-nums">{ value }</span>
		<span class="text-muted-foreground text-xs">{ label }</span>
	</div>
}
