package dashboard

import (
	"fmt"
	"templ-app/components/button"
	"templ-app/components/card"
	"templ-app/components/dialog"
	"templ-app/components/dropdownmenu"
	"templ-app/components/field"
	"templ-app/components/icon"
	"templ-app/components/input"
	"templ-app/components/table"
	"templ-app/components/textarea"
	"templ-app/utils"
)

var linkStatusOptions = []option{
	{Value: "all", Label: "All statuses"},
	{Value: "active", Label: "Active"},
	{Value: "paused", Label: "Paused"},
	{Value: "completed", Label: "Completed"},
	{Value: "expired", Label: "Expired"},
	{Value: "archived", Label: "Archived"},
}

// Links is the payment links page.
templ Links(d LinksData) {
	<div class="grid gap-6">
		@pageHead("Payment links", "Hosted checkout pages you can share anywhere. No code required.", d.Sandbox) {
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
				@icon.BookOpen(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
				Guide
			}
			@createLinkDialog(d)
		}
		@pageAlert(d.Error, d.Notice)
		@statStrip(d.Stats)
		@card.Card() {
			@card.Header() {
				@card.Title() {
					All links
				}
				@card.Description() {
					{ fmt.Sprintf("%d links · hosted at %s", d.Total, d.Host) }
				}
				@card.Action(card.ActionProps{Class: "flex flex-wrap gap-2"}) {
					@searchBox("Search links", "sm:w-56")
					<form method="get" class="contents" onchange="this.requestSubmit()">
						@filterSelect("status", linkStatusOptions, statusOr(d.Status), "sm:w-36")
					</form>
				}
			}
			@card.Content(card.ContentProps{Class: "px-0"}) {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head(table.HeadProps{Class: "pl-(--card-spacing)"}) {
								Link
							}
							@table.Head(table.HeadProps{Class: "hidden md:table-cell"}) {
								URL
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Amount
							}
							@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
								Accepts
							}
							@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
								Conversion
							}
							@table.Head(table.HeadProps{Class: "hidden text-right xl:table-cell"}) {
								Revenue
							}
							@table.Head() {
								Status
							}
							@table.Head(table.HeadProps{Class: "hidden text-right sm:table-cell"}) {
								Created
							}
							@table.Head(table.HeadProps{Class: "w-10 pr-(--card-spacing)"}) {
								<span class="sr-only">Actions</span>
							}
						}
					}
					@table.Body() {
						for _, l := range d.Links {
							@table.Row() {
								@table.Cell(table.CellProps{Class: "pl-(--card-spacing)"}) {
									<div class="flex flex-col">
										<span class="font-medium">{ l.Name }</span>
										<span class="text-muted-foreground font-mono text-xs">{ l.ID }</span>
									</div>
								}
								@table.Cell(table.CellProps{Class: "hidden max-w-56 md:table-cell"}) {
									@monoValue(l.URL, "text-muted-foreground w-full")
								}
								@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
									if l.Amount == "" {
										<span class="text-muted-foreground">Any amount</span>
									} else {
										<span class="font-medium">{ l.Amount }</span>
									}
								}
								@table.Cell(table.CellProps{Class: "hidden lg:table-cell"}) {
									@tokenStack(l.Assets)
								}
								@table.Cell(table.CellProps{Class: "hidden lg:table-cell"}) {
									<div class="flex flex-col gap-1">
										<span class="text-xs tabular-nums">{ fmt.Sprintf("%d paid · %d views", l.Paid, l.Views) }</span>
										<span class="bg-muted h-1.5 w-24 overflow-hidden rounded-full">
											<span class="bg-primary block h-full rounded-full" style={ templ.SafeCSS(fmt.Sprintf("width:%.0f%%", l.Conversion())) }></span>
										</span>
									</div>
								}
								@table.Cell(table.CellProps{Class: "hidden text-right tabular-nums xl:table-cell"}) {
									{ l.Revenue }
								}
								@table.Cell() {
									@pill(string(l.Status), linkStatusClass(l.Status))
								}
								@table.Cell(table.CellProps{Class: "text-muted-foreground hidden text-right text-xs whitespace-nowrap sm:table-cell"}) {
									{ l.Created }
									if l.Expires != "Never" {
										<br/>
										<span class={ utils.IfElse(l.Status == LinkExpired, "text-rose-600 dark:text-rose-400", "") }>{ "expires " + l.Expires }</span>
									}
								}
								@table.Cell(table.CellProps{Class: "pr-(--card-spacing) text-right"}) {
									@linkRowMenu(l)
								}
							}
						}
					}
				}
			}
			@tableFooter(len(d.Links), d.Total, "links")
		}
	</div>
}

templ linkRowMenu(l PaymentLink) {
	@dropdownmenu.DropdownMenu() {
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Attributes: dropdownmenu.Trigger(ctx)}) {
			@icon.Ellipsis()
			<span class="sr-only">Actions</span>
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Class: "w-48"}) {
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"onclick": "navigator.clipboard&&navigator.clipboard.writeText('" + l.URL + "')"}}) {
				@icon.Copy()
				Copy link
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Href: l.URL, Target: "_blank"}) {
				@icon.ExternalLink()
				Open checkout
			}
			@dropdownmenu.Separator()
			if l.Status == LinkPaused {
				@menuForm("/dashboard/links/status", l.Ref, "status", "active") {
					@submitItem(false) {
						@icon.Play()
						Resume
					}
				}
			} else if l.Status == LinkActive {
				@menuForm("/dashboard/links/status", l.Ref, "status", "paused") {
					@submitItem(false) {
						@icon.Pause()
						Pause
					}
				}
			}
			@dropdownmenu.Separator()
			@menuForm("/dashboard/links/status", l.Ref, "status", "archived") {
				@submitItem(true) {
					@icon.Archive()
					Archive
				}
			}
		}
	}
}

// currenciesOf and assetsOf prefer the handler's catalog and fall back to the
// fixture lists, so the dialog works in both modes.
func currenciesOf(d LinksData) []option {
	if len(d.Currencies) > 0 {
		return d.Currencies
	}
	return currencyOptions
}

func defaultCurrency(d LinksData) string {
	if len(d.Currencies) > 0 {
		return d.Currencies[0].Value
	}
	return "USD"
}

func assetsOf(d LinksData) []option {
	if len(d.Assets) > 0 {
		return d.Assets
	}
	return assetChoices()
}

var currencyOptions = []option{
	{Value: "USD", Label: "USD"},
	{Value: "EUR", Label: "EUR"},
	{Value: "GBP", Label: "GBP"},
	{Value: "USDT", Label: "USDT"},
	{Value: "BTC", Label: "BTC"},
}

var expiryOptions = []option{
	{Value: "never", Label: "Never"},
	{Value: "24h", Label: "In 24 hours"},
	{Value: "7d", Label: "In 7 days"},
	{Value: "30d", Label: "In 30 days"},
}

// createLinkDialog is the "Create payment link" form in a modal.
templ createLinkDialog(d LinksData) {
	@dialog.Dialog() {
		@button.Button(button.Props{Size: button.SizeSm, Attributes: dialog.Trigger(ctx)}) {
			@icon.Plus(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
			Create link
		}
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg"}) {
			@dialog.Header() {
				@dialog.Title() {
					Create payment link
				}
				@dialog.Description() {
					if d.Sandbox {
						Test links only accept simulated payments.
					} else {
						Share the link or embed it as a button on your site.
					}
				}
			}
			<form class="grid gap-4" method="post" action="/dashboard/links">
				@field.Field() {
					@field.Label(field.LabelProps{For: "link-name"}) {
						Name
					}
					@input.Input(input.Props{ID: "link-name", Name: "name", Placeholder: "Pro plan · annual", Required: true})
					@field.Description() {
						Shown to the customer on the checkout page.
					}
				}
				<div class="grid gap-4 sm:grid-cols-[1fr_8rem]">
					@field.Field() {
						@field.Label(field.LabelProps{For: "link-amount"}) {
							Amount
						}
						@input.Input(input.Props{ID: "link-amount", Name: "amount", Type: "number", Placeholder: "0.00", Attributes: templ.Attributes{"step": "0.01", "min": "0"}})
					}
					@field.Field() {
						@field.Label(field.LabelProps{For: "link-currency"}) {
							Currency
						}
						@fieldSelect("currency", currenciesOf(d), defaultCurrency(d))
					}
				</div>
				@checkbox("any_amount", "Let the customer choose the amount", false)
				@field.Field() {
					@field.Label() {
						Accepted assets
					}
					<div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
						for _, a := range assetsOf(d) {
							@checkboxValue("assets", a.Value, a.Label, false)
						}
					</div>
					@field.Description() {
						Leave every box clear to accept whatever the merchant has enabled.
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "link-description"}) {
						Description
					}
					@textarea.Textarea(textarea.Props{ID: "link-description", Name: "description", Placeholder: "Optional note shown under the amount", Rows: 2})
				}
				<div class="grid gap-4 sm:grid-cols-2">
					@field.Field() {
						@field.Label(field.LabelProps{For: "link-expiry"}) {
							Expires
						}
						@fieldSelect("expires", expiryOptions, "never")
					}
					@field.Field(field.Props{Class: "justify-end"}) {
						@checkbox("reusable", "Reusable link", true)
						@checkbox("collect_email", "Collect customer email", true)
					}
				</div>
				@dialog.Footer() {
					@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Create link
					}
				}
			</form>
		}
	}
}
